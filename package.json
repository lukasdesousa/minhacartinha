    "deploy:cloudflare:dry": "npm run build:vinext && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
