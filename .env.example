DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="seu-api-secret"
CLOUDINARY_FOLDER_NAME="minha-cartinha"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY="re_sua-chave"
RESEND_DOMAIN="seudominio.com.br"
# Opcional: sobrescreve o remetente derivado de RESEND_DOMAIN
RESEND_FROM_EMAIL="Minha Cartinha <cartinhas@seudominio.com.br>"
RESEND_REPLY_TO_EMAIL="contato@seudominio.com.br"

# Pix: credenciais privadas, somente no servidor. Nunca use NEXT_PUBLIC_ aqui.
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
# ID numérico da conta vendedora que receberá os pagamentos
MERCADO_PAGO_COLLECTOR_ID=""
# false para homologação; true apenas com credenciais de produção
MERCADO_PAGO_LIVE_MODE="false"
# Critério operacional: bruto aprovado menos reembolsos/estornos, sem taxas.
# Alternativa: NET_AFTER_FEES. Cada compra conserva o critério vigente na criação.
ANIMAL_CAUSE_ALLOCATION_BASIS="GROSS_AFTER_REFUNDS"
